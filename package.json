{
  "name": "xcreenshot",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "site:dev": "vite --config site/vite.config.ts",
    "site:build": "vite build --config site/vite.config.ts",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "oxlint --deny-warnings && prettier --check .",
    "format": "oxlint --fix && prettier --write .",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "readme-media": "node scripts/readme-media.ts",
    "icons": "tauri icon assets/icon.svg && rm -rf src-tauri/icons/android src-tauri/icons/ios && rsvg-convert -w 22 -h 22 assets/tray.svg -o src-tauri/icons/tray-template.png && rsvg-convert -w 44 -h 44 assets/tray.svg -o src-tauri/icons/tray-template@2x.png",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.69.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.4",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "bits-ui": "^2.20.6",
    "cn": "^0.5.2",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.0",
    "motion": "^14.9.1",
    "oxlint": "^1.91.0",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn-svelte": "^1.8.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "konva": "^10.9.1"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=26"
  }
}
