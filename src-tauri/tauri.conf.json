{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "xcreenshot",
  "version": "../package.json",
  "identifier": "com.bervex.xcreenshot",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "freezePrototype": true,
      "devCsp": "default-src 'self'; img-src 'self' asset: blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost ws://localhost:5173"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "copyright": "\u00a9 2026 cberd1509 and xcreenshot contributors",
    "shortDescription": "Fast, private screenshots",
    "macOS": {
      "minimumSystemVersion": "14.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE1OEE1OENFMjJENzE5OTYKUldTV0dkY2l6bGlLcFlEclB2WkhXUWxRNFAzYkNaZEY5dU5nODc4VnpKSXR1dzNTai9kR21PeTUK",
      "endpoints": [
        "https://github.com/cberd1509/xcreenshot/releases/latest/download/latest.json"
      ]
    }
  }
}
