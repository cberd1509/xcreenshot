{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "overlay",
  "description": "Capture overlay windows: show and hide events, frame fetch, close",
  "windows": ["overlay-*"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-overlay-frame",
    "allow-overlay-painted",
    "allow-close-overlay"
  ]
}
