{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "overlay",
  "description": "Capture overlay windows: show event, frame fetch, paint report, selection, confirm, close",
  "windows": ["overlay-*"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-overlay-ready",
    "allow-overlay-frame",
    "allow-overlay-painted",
    "allow-overlay-selection",
    "allow-overlay-confirm",
    "allow-close-overlay"
  ]
}
